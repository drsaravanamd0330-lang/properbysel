# ProperBySel environment variables. Copy to .env and fill in. Never commit real secrets.

# --- Core ---
NODE_ENV=development
APP_ENV=development            # development | staging | production
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://pbs:pbs@localhost:5432/properbysel
TEST_DATABASE_URL=postgresql://pbs:pbs@localhost:5432/properbysel_test

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# OTP provider: "dev" prints codes to the API log and is REJECTED when APP_ENV=production.
OTP_PROVIDER=dev               # dev | msg91 | twilio
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=          # DLT-registered template with an "otp" variable
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Storage ---
STORAGE_PROVIDER=local         # local | s3
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments (Phase 4) ---
PAYMENT_PROVIDER=sandbox       # sandbox | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Maps ---
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Seller details printed on receipts. Receipts say "not a tax invoice" until BUSINESS_GSTIN is set.
BUSINESS_LEGAL_NAME="AAROVIN SOFTWARE SOLUTIONS"
BUSINESS_GSTIN=
BUSINESS_ADDRESS=

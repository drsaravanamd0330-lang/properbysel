{
  "name": "@pbs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.3.0",
    "@pbs/domain": "workspace:*",
    "@pbs/validation": "workspace:*",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "dotenv-cli": "11.1.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
